# Test-only env. Loaded by tests/setup-env.ts (bun preload).
# Copy this file to .env.test.local and fill values from `supabase start` output.

# Local Supabase stack (started via `supabase start` from inner repo).
# These point at the Docker stack at 127.0.0.1, NOT the cloud project.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Run `supabase start` and copy the "Publishable" and "Secret" keys here.
# These are deterministic per project_id (kova-open-pencil) — same across restarts.
SUPABASE_LOCAL_ANON_KEY=
SUPABASE_LOCAL_SERVICE_KEY=
