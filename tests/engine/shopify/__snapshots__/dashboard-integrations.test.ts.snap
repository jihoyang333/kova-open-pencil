// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`IntegrationsCard snapshots not-connected state matches snapshot 1`] = `
"<div data-test-id="integrations-card" class="rounded-xl border border-gray-200 bg-white p-5">
  <h2 class="text-sm font-semibold text-gray-900">Integrations</h2><!-- Loading -->
  <!-- Not connected -->
  <div data-test-id="integrations-not-connected" class="mt-4">
    <p class="text-sm text-gray-500">No Shopify store connected.</p>
    <div class="mt-3"><button data-test-id="integrations-connect-btn" class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-700"> Connect Shopify </button></div>
  </div>
</div>"
`;

exports[`IntegrationsCard snapshots connected state matches snapshot 1`] = `
"<div data-test-id="integrations-card" class="rounded-xl border border-gray-200 bg-white p-5">
  <h2 class="text-sm font-semibold text-gray-900">Integrations</h2><!-- Loading -->
  <!-- Connected -->
  <div data-test-id="integrations-connected" class="mt-4">
    <div class="flex items-center gap-2">
      <icon-lucide-check-circle-stub class="size-4 text-green-500"></icon-lucide-check-circle-stub><span data-test-id="integrations-shop-domain" class="text-sm font-medium text-gray-900">acme.myshopify.com</span>
    </div>
    <p data-test-id="integrations-last-sync" class="mt-1 text-xs text-gray-500">Never synced</p>
    <div class="mt-3 flex items-center gap-3"><button data-test-id="integrations-disconnect-btn" class="text-xs text-gray-500 underline transition-colors hover:text-red-600 disabled:opacity-50">Disconnect</button><span class="text-xs text-gray-300">|</span><a data-test-id="integrations-settings-link" class="text-xs text-gray-500 underline hover:text-gray-900"> Settings </a></div>
  </div>
</div>"
`;

exports[`IntegrationsCard snapshots reauthorize state matches snapshot 1`] = `
"<div data-test-id="integrations-card" class="rounded-xl border border-gray-200 bg-white p-5">
  <h2 class="text-sm font-semibold text-gray-900">Integrations</h2><!-- Loading -->
  <!-- Reauthorize -->
  <div data-test-id="integrations-reauthorize" class="mt-4">
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-3">
      <div class="flex items-start gap-2">
        <icon-lucide-alert-triangle-stub class="mt-0.5 size-4 shrink-0 text-amber-600"></icon-lucide-alert-triangle-stub>
        <div>
          <p class="text-sm font-medium text-amber-800">Shopify needs to be reauthorized</p>
          <p data-test-id="integrations-reauth-domain" class="mt-0.5 text-xs text-amber-700">pending.myshopify.com</p>
        </div>
      </div><button data-test-id="integrations-reauthorize-btn" class="mt-3 rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-amber-500"> Reauthorize </button>
    </div>
  </div>
</div>"
`;
