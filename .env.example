# Kova environment variables — copy to .env.local for local dev.
# DO NOT commit .env.local. All values here are placeholders.

# ============================================================================
# Browser-safe (Vite-injected, prefixed VITE_)
# ============================================================================

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-jwt>
VITE_APP_URL=http://localhost:1420

# ============================================================================
# Server-only (Edge Functions / cron / Stripe webhooks — NEVER prefixed VITE_)
# ============================================================================

SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>
ANTHROPIC_API_KEY=sk-ant-<key>

# Stripe (Cluster 04 ships the full wiring)
STRIPE_SECRET_KEY=sk_test_<key>
STRIPE_WEBHOOK_SECRET=whsec_<key>

# Resend (Cluster 11 ships the wrapper; deferred to pre-launch — stub fires when unset)
RESEND_API_KEY=re_<key>

# Vercel Cron (deferred to pre-launch — request guard rejects without this)
CRON_SECRET=<random-32-byte-hex>

# ============================================================================
# Cluster 01 — Auth & Identity
# ============================================================================

# Email-change confirmation link TTL — matches Supabase Auth secure-email-change
# token expiry. Surfaced in B5.2 "expired link" copy. Document any override.
EMAIL_CHANGE_LINK_TTL_HOURS=24
